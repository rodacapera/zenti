# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Habilitar modular headers globalmente para Firebase y dependencias Swift
# Esto es necesario para que los pods Swift funcionen como librerías estáticas
use_modular_headers!

## Desactivar Hermes en CI para evitar el script que falla en GitHub Actions
hermes_enabled = ENV['CI'] == 'true' ? false : true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Zenti' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # Control de Hermes: desactívalo en CI, actívalo localmente
    hermes_enabled: hermes_enabled
  )

    # No declarar Yoga explícitamente; React Native lo integra desde ReactCommon/yoga

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Configurar deployment target mínimo y módulos para todos los pods
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Forzar deployment target mínimo a 12.0 (requerido por Xcode moderno)
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 12.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
        end
        
        # Asegurar que CLANG_ENABLE_MODULES esté habilitado para todos los pods
        config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        # Estandarizar compiladores para evitar incompatibilidades con libc++ en Xcode 16
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] || 'c++17'
        config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        config.build_settings['GCC_C_LANGUAGE_STANDARD'] = 'gnu11'
        # Permitir includes no modulares globalmente (evita fallas con headers de RN/Yoga/grpc)
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        # Habilitar header maps globalmente
        config.build_settings['USE_HEADERMAP'] = 'YES'
        # Bandera de compatibilidad de libc++ para símbolos removidos en C++17 (evita errores en headers estándar)
        existing_cpp_flags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        existing_cpp_flags = [existing_cpp_flags] if existing_cpp_flags.is_a?(String)
        ['-D_LIBCPP_ENABLE_CXX17_REMOVED_FEATURES',
         '-I$(SRCROOT)/../node_modules/react-native/ReactCommon',
         '-I$(SRCROOT)/../node_modules/react-native/ReactCommon/yoga'].each do |flag|
          existing_cpp_flags << flag unless existing_cpp_flags.include?(flag)
        end
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = existing_cpp_flags
        # Añadir -I también a OTHER_CFLAGS (para compilación C/ObjC)
        existing_c_flags = config.build_settings['OTHER_CFLAGS'] || ['$(inherited)']
        existing_c_flags = [existing_c_flags] if existing_c_flags.is_a?(String)
        ['-I$(SRCROOT)/../node_modules/react-native/ReactCommon',
         '-I$(SRCROOT)/../node_modules/react-native/ReactCommon/yoga'].each do |flag|
          existing_c_flags << flag unless existing_c_flags.include?(flag)
        end
        config.build_settings['OTHER_CFLAGS'] = existing_c_flags
        # Asegurar rutas de headers clave de RN/Yoga
        global_hs = config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
        global_hs = [global_hs] if global_hs.is_a?(String)
        [
          '$(PODS_ROOT)/Headers/Public',
          '$(PODS_ROOT)/Headers/Private',
          '$(PODS_ROOT)/Headers/Public/Yoga',
          '$(PODS_ROOT)/Headers/Public/React',
          '$(PODS_ROOT)/Headers/Public/ReactCommon',
          '$(PODS_ROOT)/../../node_modules/react-native/ReactCommon',
          '$(PODS_ROOT)/../../node_modules/react-native/ReactCommon/yoga'
        ].each do |path|
          global_hs << path unless global_hs.include?(path)
        end
        config.build_settings['HEADER_SEARCH_PATHS'] = global_hs

        # Refuerzo específico para ReactCommon (incluye Yoga)
        if target.name == 'ReactCommon'
          rc_hs = config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
          rc_hs = [rc_hs] if rc_hs.is_a?(String)
          [
            '$(PODS_ROOT)/../../node_modules/react-native/ReactCommon',
            '$(PODS_ROOT)/../../node_modules/react-native/ReactCommon/yoga',
            '$(PODS_ROOT)/Headers/Public/Yoga'
          ].each do |path|
            rc_hs << path unless rc_hs.include?(path)
          end
          config.build_settings['HEADER_SEARCH_PATHS'] = rc_hs
        end
        
        # Configurar Swift version si es necesario
        if target.respond_to?(:product_type) and target.product_type == "com.apple.product-type.bundle"
          config.build_settings['SWIFT_VERSION'] = '5.0'
        end
        
        # Configuración específica para pods problemáticos de gRPC/BoringSSL
        if target.name.start_with?('BoringSSL') || target.name.start_with?('gRPC')
          # Desactivar warnings como errores para estos pods
          config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
          config.build_settings['WARNING_CFLAGS'] = '-Wno-shorten-64-to-32 -Wno-comma -Wno-unreachable-code -Wno-format -Wno-everything'
          
          # Configurar estándar C++ (BoringSSL requiere C++14 o superior)
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
          
          # Desactivar bitcode explícitamente (ya lo tenemos desactivado globalmente)
          config.build_settings['ENABLE_BITCODE'] = 'NO'
          # Permitir includes no modulares dentro de módulos de framework (evita fallas de módulo)
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          # Asegurar header maps para que CocoaPods genere/sincronice Headers/Private y Public correctamente
          config.build_settings['USE_HEADERMAP'] = 'YES'
          # Asegurar que los pods de gRPC definan módulo para que exista su modulemap
          if ['gRPC-Core', 'gRPC-C++', 'BoringSSL-GRPC'].include?(target.name)
            config.build_settings['DEFINES_MODULE'] = 'YES'
          end
          # Asegurar rutas de búsqueda de headers públicas y privadas (por si Xcode no las hereda)
          existing_hs = config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
          existing_hs = [existing_hs] if existing_hs.is_a?(String)
          ['$(PODS_ROOT)/Headers/Public', '$(PODS_ROOT)/Headers/Private'].each do |path|
            existing_hs << path unless existing_hs.include?(path)
          end
          config.build_settings['HEADER_SEARCH_PATHS'] = existing_hs
          
          # Configuración específica para BoringSSL-GRPC
          if target.name == 'BoringSSL-GRPC'
            # Agregar definiciones del preprocesador de forma segura
            existing_defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
            existing_defs = [existing_defs] if existing_defs.is_a?(String)
            existing_defs << 'OPENSSL_NO_ASM=1' unless existing_defs.include?('OPENSSL_NO_ASM=1')
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = existing_defs
            
            # Desactivar optimización de Swift completamente para este target
            config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
            config.build_settings['SWIFT_COMPILATION_MODE'] = 'singlefile'
            
            # Optimización más baja para C/C++
            config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0'
            
            # Configuración adicional para evitar errores de compilación
            config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
            # Mantener header maps activos
            config.build_settings['USE_HEADERMAP'] = 'YES'
            config.build_settings['CLANG_WARN_DOCUMENTATION_COMMENTS'] = 'NO'
            config.build_settings['CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING'] = 'NO'
            
            # Desactivar módulos Swift para evitar problemas de previews
            config.build_settings['SWIFT_ENABLE_PREVIEWS'] = 'NO'
          end
          
          # Asegurar que Yoga exponga headers como módulo y tenga rutas correctas
          if target.name == 'Yoga'
            config.build_settings['DEFINES_MODULE'] = 'YES'
            # Algunos setups requieren explicitar carpeta de headers públicos
            config.build_settings['PUBLIC_HEADERS_FOLDER_PATH'] = 'include'
            yoga_hs = config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
            yoga_hs = [yoga_hs] if yoga_hs.is_a?(String)
            [
              '$(PODS_ROOT)/Headers/Public/Yoga',
              '$(PODS_ROOT)/Headers/Private/Yoga',
              '$(PODS_TARGET_SRCROOT)',
              '$(PODS_ROOT)/../../node_modules/react-native/ReactCommon/yoga'
            ].each do |path|
              yoga_hs << path unless yoga_hs.include?(path)
            end
            config.build_settings['HEADER_SEARCH_PATHS'] = yoga_hs
          end
        end
      end
    end

    # Añadir rutas de headers también al target de la app (Zenti), no solo a Pods
    installer.aggregate_targets.each do |aggregate|
      aggregate.user_project.native_targets.each do |native_target|
        next unless native_target.name == 'Zenti'
        native_target.build_configurations.each do |config|
          app_hs = config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
          app_hs = [app_hs] if app_hs.is_a?(String)
          [
            '$(SRCROOT)/../node_modules/react-native/ReactCommon',
            '$(SRCROOT)/../node_modules/react-native/ReactCommon/yoga',
            '$(PODS_ROOT)/Headers/Public/Yoga',
            '$(PODS_ROOT)/Headers/Public/React',
            '$(PODS_ROOT)/Headers/Public'
          ].each do |path|
            app_hs << path unless app_hs.include?(path)
          end
          config.build_settings['HEADER_SEARCH_PATHS'] = app_hs
        end
      end
    end
  end
end

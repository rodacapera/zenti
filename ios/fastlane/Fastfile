default_platform(:ios)

platform :ios do
  desc "🚀 Compilar y subir a TestFlight"

  lane :beta do
    UI.message("🚀 Preparando keychain para certificados…")

    # 1) Configuramos un keychain temporal
    keychain_name = "build.keychain"
    keychain_password = ENV["MATCH_PASSWORD"]

    setup_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    UI.message("🔓 Keychain '#{keychain_name}' listo y desbloqueado")

    # 🔐 Descargar certificados y perfiles desde el repositorio privado (modo readonly)
    match(
      type: "appstore",
      app_identifier: "com.teranov.zentiapp",
      username: ENV["APPLE_ID"],
      team_id: ENV["APPLE_DEVELOPMENT_TEAM_ID"],
      git_url: "https://github.com/rodacapera/certificates-zenti",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      readonly: true,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    UI.message("🔐 Certificados y perfiles instalados en '#{keychain_name}'")

    # 🏗️ Construcción de la app
    build_app(
      scheme: "Zenti",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.teranov.zentiapp" => "match AppStore com.teranov.zentiapp"
        },
        method: "app-store",
        signingStyle: "manual", # ← ¡CAMBIO CRÍTICO!
        teamID: ENV["APPLE_DEVELOPMENT_TEAM_ID"],
        compileBitcode: true,
        uploadSymbols: true,
        stripSwiftSymbols: true
      },
      clean: true,
      output_directory: "build",
      export_team_id: ENV["APPLE_DEVELOPMENT_TEAM_ID"]
    )

    # ☁️ Subir a TestFlight
    UI.message("☁️ Subiendo a TestFlight para #{ENV["APPLE_ID"]}")
    upload_to_testflight(
      username: ENV["APPLE_ID"],
      skip_waiting_for_build_processing: true,
      app_identifier: "com.teranov.zentiapp"
    )
  end
end

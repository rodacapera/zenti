default_platform(:ios)

platform :ios do
  desc "🚀 Compilar y subir a TestFlight"

  lane :beta do
    # 👷‍♂️ Compilar la app
    build_app(
      scheme: "Zenti",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        teamID: "XK4QBKULJR",
        signingStyle: "automatic",
        uploadSymbols: true,
        compileBitcode: true
      },
      clean: true,
      allowProvisioningUpdates: true # 👈 IMPORTANTE
    )

    # ☁️ Subir a TestFlight
    upload_to_testflight(
      username: ENV["APPLE_ID"],
      skip_waiting_for_build_processing: true,
      app_identifier: "com.teranov.zentiapp"
    )
  end
end

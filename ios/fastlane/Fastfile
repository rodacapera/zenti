default_platform(:ios)

platform :ios do
  desc "🚀 Compilar y subir a TestFlight"

  lane :beta do
    UI.message("🚀 Compilando la app Zenti con Fastlane")

    # 📌 Forzar Xcode 16.2 para evitar ambigüedad de versión en runners con múltiples Xcodes
    begin
      xcode_select("/Applications/Xcode_16.2.app")
      ENV["DEVELOPER_DIR"] = "/Applications/Xcode_16.2.app/Contents/Developer"
      UI.message("📌 Xcode seleccionado: #{sh('xcodebuild -version | head -n 1').strip}")
    rescue => e
      UI.important("⚠️ No se pudo fijar Xcode vía xcode_select: #{e}")
    end

    # 🔐 Configurar keychain si estamos en CI
    if ENV["CI"] == "true"
      UI.message("🔐 Configurando keychain para CI...")
      # Asegurar que el keychain esté desbloqueado y configurado correctamente
      sh("security unlock-keychain -p '' build.keychain || true")
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '' build.keychain || true")
    end

    # 🔐 Descargar certificados y perfiles
    match(
      type: "appstore",
      app_identifier: "com.teranov.zentiapp",
      username: ENV["APPLE_ID"],
      team_id: ENV["APPLE_DEVELOPMENT_TEAM_ID"],
      git_url: "https://github.com/rodacapera/certificates-zenti",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      readonly: true,
      keychain_name: "build.keychain",
      keychain_password: "",
      verbose: true
    )

    # 🧹 Limpiar build anterior y DerivedData
    UI.message("🧹 Limpiando build anterior...")
    sh("rm -rf build/*.xcarchive build/*.ipa || true")
    # Limpiar DerivedData para evitar problemas de compilación
    if ENV["CI"] == "true"
      UI.message("🧹 Limpiando DerivedData en CI...")
      sh("rm -rf ~/Library/Developer/Xcode/DerivedData/Zenti-* || true")
    end
    
    # 🏗️ Construcción de la app
    begin
      # Crear directorio de logs si no existe (usar ruta absoluta)
      ios_root = File.expand_path('..', Dir.pwd)
      logs_dir = "#{ios_root}/build/logs"
      sh("mkdir -p #{logs_dir} || true")
      
      UI.message("🏗️ Iniciando build...")
      UI.message("📂 Logs se guardarán en: #{logs_dir}")
      
      build_app(
        workspace: "Zenti.xcworkspace",
        scheme: "Zenti",
        export_method: "app-store",
        clean: true, # Limpiar antes de construir
        export_options: {
          provisioningProfiles: {
            "com.teranov.zentiapp" => "match AppStore com.teranov.zentiapp"
          },
          method: "app-store",
          signingStyle: "manual",
          teamID: ENV["APPLE_DEVELOPMENT_TEAM_ID"],
          compileBitcode: false, # 🚀 Desactivado para acelerar
          uploadSymbols: true,
          stripSwiftSymbols: true
        },
        output_directory: "build",
        export_team_id: ENV["APPLE_DEVELOPMENT_TEAM_ID"],
        codesigning_identity: "Apple Distribution",
        skip_profile_detection: false,
        xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{ENV['APPLE_DEVELOPMENT_TEAM_ID']} GCC_WARN_INHIBIT_ALL_WARNINGS=YES CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER=NO",
        build_path: "./build",
        silent: false,
        suppress_xcode_output: false,
        buildlog_path: logs_dir, # Usar ruta absoluta
        disable_xcpretty: true # Desactivar xcpretty/xcbeautify para ver el output completo sin formateo
      )
    rescue => ex
      UI.error("❌ Error al construir la app: #{ex.message}")
      
      # Buscar el log en todos los lugares posibles INMEDIATAMENTE después del error
      UI.message("🔍 Buscando logs inmediatamente después del error...")
      
      # Primero, verificar si el log que fastlane menciona existe (ruta absoluta)
      fastlane_log_path = "#{logs_dir}/Zenti-Zenti.log"
      if File.exist?(fastlane_log_path)
        UI.message("✅ Encontrado log en: #{fastlane_log_path}")
        UI.message("📏 Tamaño: #{File.size(fastlane_log_path)} bytes")
        UI.message("--- ERRORES ENCONTRADOS ---")
        sh("grep -i -E 'error:|failed|FAILED|CompileC.*failed|The following build commands failed' '#{fastlane_log_path}' | tail -150 || true")
        UI.message("--- ÚLTIMAS 600 LÍNEAS (donde están los errores) ---")
        sh("tail -600 '#{fastlane_log_path}' || true")
      else
        UI.message("⚠️ El log en #{fastlane_log_path} no existe")
      end
      
      # Buscar en build/logs relativo
      if Dir.exist?(logs_dir)
        UI.message("📂 Buscando en #{logs_dir}...")
        sh("ls -lah #{logs_dir} || true")
        log_files = Dir.glob("#{logs_dir}/**/*")
        if log_files.any?
          log_files.each do |log_file|
            next unless File.file?(log_file)
            UI.message("📄 Encontrado: #{log_file} (#{File.size(log_file)} bytes)")
            if log_file.end_with?('.log') || log_file.include?('Zenti')
              UI.message("--- ERRORES EN #{log_file} ---")
              sh("grep -i -E 'error:|failed|FAILED|CompileC.*failed|The following build commands failed' '#{log_file}' | tail -150 || true")
              UI.message("--- ÚLTIMAS 600 LÍNEAS DE #{log_file} ---")
              sh("tail -600 '#{log_file}' || true")
            end
          end
        else
          UI.message("⚠️ No hay archivos en #{logs_dir}")
        end
      end
      
      # Buscar en el directorio de gym (donde fastlane/gym guarda logs por defecto)
      gym_log_dir = "/Users/runner/Library/Logs/gym"
      if Dir.exist?(gym_log_dir)
        UI.message("📂 Buscando en #{gym_log_dir}...")
        sh("ls -lah #{gym_log_dir} || true")
        log_files = Dir.glob("#{gym_log_dir}/**/*.log")
        if log_files.any?
          log_files.each do |log_file|
            UI.message("📄 Analizando: #{log_file}")
            sh("grep -i -E 'error:|failed|FAILED|CompileC.*failed|The following build commands failed' '#{log_file}' | tail -150 || true")
            sh("tail -600 '#{log_file}' || true")
          end
        end
      end
      
      # Buscar en DerivedData donde xcodebuild guarda logs
      UI.message("📂 Buscando en DerivedData (logs recientes)...")
      sh("find ~/Library/Developer/Xcode/DerivedData -name '*.log' -type f -mmin -10 2>/dev/null | head -3 | while read f; do echo '=== $f ==='; grep -i -E 'error:|failed|FAILED' '$f' | tail -50; tail -300 '$f'; done || true")
      
      raise ex
    end

    # ☁️ Subir a TestFlight
    UI.message("☁️ Subiendo a TestFlight para #{ENV["APPLE_ID"]}")
    upload_to_testflight(
      username: ENV["APPLE_ID"],
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      app_identifier: "com.teranov.zentiapp"
    )
  end
end
